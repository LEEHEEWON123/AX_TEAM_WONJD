SUPABASE_SECRET_FETCH_TOKEN=replace-with-long-random-token
SERVER_SECRET_ALLOWED_NAMES=DATABASE_URL,STRIPE_SECRET_KEY

# Secrets returned by the function must also exist here in local serve,
# and must be added as remote Supabase function secrets in production.
DATABASE_URL=postgres://user:password@host:5432/db
STRIPE_SECRET_KEY=sk_live_xxx
